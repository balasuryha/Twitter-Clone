er-X-clone/twitter-X-clone/client/src/index.js",[],"/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/App.js",[],"/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/redux/store.js",["245"],"import { configureStore, getDefaultMiddleware } from \"@reduxjs/toolkit\";\nimport modalSlicer from \"./slicers/modalSlicer\";\nimport visitedProfileSlicer from \"./slicers/visitedProfileSlicer\";\nimport tweetSlicer from \"./slicers/tweetSlicer\";\nimport currentProfileSlicer from \"./slicers/currentProfileSlicer\";\n\nexport default configureStore({\n  reducer: {\n    visitedProfile: visitedProfileSlicer,\n    currentProfile: currentProfileSlicer,\n    modal: modalSlicer,\n    tweet: tweetSlicer,\n  },\n  middleware: (getDefaultMiddleware) =>\n    getDefaultMiddleware({ serializableCheck: false }),\n});\n","/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/views/Signin.js",[],"/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/components/PrivateRoute.js",[],"/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/views/NewTweet.js",[],"/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/views/Signup.js",[],"/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/views/Profile.js",[],"/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/views/Edit.js",[],"/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/views/Explore.js",[],"/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/views/Tweet.js",[],"/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/views/Settings.js",[],"/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/views/Home.js",[],"/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/views/Notifications.js",[],"/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/views/Bookmark.js",[],"/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/views/Messages.js",[],"/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/redux/slicers/visitedProfileSlicer.js",[],"/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/redux/slicers/tweetSlicer.js",[],"/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/redux/slicers/currentProfileSlicer.js",[],"/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/redux/slicers/modalSlicer.js",[],"/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/components/Spinner.js",[],"/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/components/form/SigninForm.js",[],"/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/components/form/NewTweetForm.js",["246"],"import getFormData from \"../../utils/getFormData\";\nimport { useSelector, useDispatch } from \"react-redux\";\nimport { RiFileGifLine, GrEmoji, FiImage } from \"react-icons/all\";\nimport Avatar from \"../avatar/Avatar\";\nimport TextareaAutosize from \"react-textarea-autosize\";\nimport { newTweet, newRetweet } from \"../../redux/actions/tweetActions\";\n\nconst NewTweetForm = () => {\n  const { username, avatar } = useSelector(\n    (state) => state.currentProfile.data\n  );\n  const dispatch = useDispatch();\n\n  const handleSubmit = (e) => {\n    e.preventDefault();\n    const formData = getFormData(e.target);\n    dispatch(newTweet(formData));\n    e.target.reset();\n  };\n\n  return (\n    <div className=\"tweet-form display-flex align-items-fs\">\n      <div className=\"tweet-form__img display-flex justify-content-c align-items-c\">\n        <Avatar username={username} avatar={avatar} size=\"small\" />\n      </div>\n      <form className=\"tweet-form__form\" onSubmit={handleSubmit}>\n        <TextareaAutosize name=\"body\" placeholder=\"What's happening?\" />\n        <div className=\"display-flex justify-content-sb align-items-c\">\n          <ul className=\"display-flex\">\n            <li>\n              <FiImage />\n            </li>\n            <li>\n              <RiFileGifLine />\n            </li>\n            <li>\n              <GrEmoji />\n            </li>\n          </ul>\n          <button className=\"tweet-form__btn\">Tweet</button>\n        </div>\n      </form>\n    </div>\n  );\n};\n\nexport default NewTweetForm;\n","/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/components/form/SignupForm.js",[],"/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/components/form/UploadAvatarForm.js",[],"/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/components/form/CommentForm.js",[],"/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/components/form/UpdateProfileForm.js",[],"/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/components/layout/Layout.js",[],"/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/components/card/ProfileCard.js",[],"/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/redux/actions/tweetActions.js",[],"/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/redux/actions/currentProfileActions.js",[],"/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/redux/actions/visitedProfileActions.js",[],"/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/components/card/TweetCard/TweetCard.js",[],"/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/components/layout/SidebarLeft.js",[],"/Users/balasuryhalavakumar/Downloads/twitter-X-clone/twitter-X-clone/client/src/components/layout/Si